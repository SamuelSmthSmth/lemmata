{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh",
  "buildCommand": "export PATH=\"$HOME/.local/bin:$PATH\" && uv run --frozen python ui/vendor_pyodide.py && uv run --frozen python ui/build_site.py",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/app/static/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app/static/(js|engine|data|guide)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/install.(sh|ps1)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "/app/static/:path*"
    }
  ]
}
