// Aether Controlled Natural Language (CNL) grammar for proof documents.
// Parser: Lark LALR + contextual lexer, postlex: AetherIndenter
//
// Design notes:
//   - STEP_KW is a bare keyword; the colon is an explicit literal in rules.
//   - All infix operators are named terminals (ADDOP, MULOP, etc.) so LALR
//     includes them in the parse tree rather than silently discarding them.
//   - arith_expr/term/power/rel_expr are NOT ?-inlined so the transformer
//     gets stable Tree nodes with children [left, op, right].

start: (_NL | item)*

item: theorem_stmt
    | proof_stmt
    | line_stmt

// -----------------------------------------------------------------------
// Theorem / proof structure
// -----------------------------------------------------------------------

theorem_stmt: THEOREM_KW (CNAME | STRING)? ":" (CNAME | STRING)? _NL (claim_stmt)? (proof_stmt)?
claim_stmt:   CLAIM_KW ":" expr _NL
proof_stmt:   PROOF_KW ":"? _NL _INDENT line_stmt+ _DEDENT (QED_KW _NL)?

line_stmt:  simple_stmt _NL
          | block_stmt

block_stmt: CASE_KW expr ":" _NL _INDENT line_stmt+ _DEDENT            -> case_block
          | BASE_CASE_KW (expr)? ":" _NL _INDENT line_stmt+ _DEDENT    -> base_case_block
          | IND_STEP_KW (expr)? ":" _NL _INDENT line_stmt+ _DEDENT     -> ind_step_block
          | CNAME ":" _NL _INDENT line_stmt+ _DEDENT                   -> named_block

// -----------------------------------------------------------------------
// Simple (single-line) proof statements
// -----------------------------------------------------------------------

simple_stmt: var_decl
           | assume_stmt
           | obtain_stmt
           | step_stmt
           | deduce_stmt
           | import_stmt
           | QED_KW

import_stmt: IMPORT_KW STRING

var_decl: VAR_INTRO var_list ":" type_name (("with"i | SUCH_THAT) expr)?        -> var_decl_typed
        | (VAR_INTRO | DEFINE_KW) CNAME "(" var_list ")" (REL_OP | IFF_OP) expr -> func_def
        | VAR_INTRO var_ident REL_OP arith_expr                                 -> var_decl_cond

assume_stmt: ASSUME_KW (CNAME ":")? expr

obtain_stmt: OBTAIN_KW var_ident (":" type_name)? SUCH_THAT expr ("from" CNAME)?

// step_chained: Step: rel rhs   — starts with REL_OP (no lhs, chains from previous step)
// step_single:  Step: expr      — full expression, including relations like 'n^2 = 4*k^2'
// LALR can distinguish these because step_chained starts with a REL_OP token.
step_stmt: STEP_KW ":" REL_OP arith_expr justification?  -> step_chained
         | STEP_KW ":" expr   justification?             -> step_single

deduce_stmt: DEDUCE_KW REL_OP arith_expr justification?             -> deduce_chained
           | DEDUCE_KW expr justification? witness_clause?          -> deduce_expr

justification: "[" JUST_TEXT "]"
             | ("using"i | "by"i) JUST_TEXT

witness_clause: "[" "witness"i ":" expr "]"

?var_ident: CNAME | GREEK_LETTER
var_list:  var_ident ("," var_ident)*
type_name: CNAME
         | "\\" "mathbb" "{" CNAME "}"
         | TYPE_SET

// -----------------------------------------------------------------------
// Expression / proposition hierarchy
// Operators are named terminals so they survive in the LALR parse tree.
// -----------------------------------------------------------------------

?expr: quant_expr

?quant_expr: QUANT_EXISTS var_ident (":" type_name)? "," quant_expr -> exists_expr
           | QUANT_FORALL var_ident (":" type_name)? "," quant_expr -> forall_expr
           // Bounded forms, as the notes write them: `forall \epsilon > 0, ...`,
           // `exists x in S, ...`, `∀ x ∈ ℝ, ...`.  The transformer decides whether
           // the bound names a type (`in Real`) or is a guard (`> 0`).
           | QUANT_EXISTS var_ident REL_OP arith_expr "," quant_expr -> exists_bounded
           | QUANT_FORALL var_ident REL_OP arith_expr "," quant_expr -> forall_bounded
           | iff_expr

// Logic levels — kept as non-? rules so children include the operator tokens
iff_expr:  impl_expr (IFF_OP  quant_expr)?
impl_expr: or_expr   (IMPL_OP quant_expr)?
or_expr:   and_expr  (OR_OP   and_expr)*
and_expr:  not_expr  (AND_OP  not_expr)*

?not_expr: NOT_OP not_expr  -> not_op
         | rel_expr

// ?rel_expr: transparent — when it has 3 children (a REL_OP b), the parent
// and_expr/or_expr/etc. rule sees them directly. The transformer handles
// RelationNode construction at the arith_expr level when REL_OP is present.
?rel_expr: arith_expr REL_OP arith_expr mod_spec? -> rel_expr_bin
         | arith_expr

mod_spec: MOD_PAR_KW arith_expr ")"
        | PMOD_KW "{" arith_expr "}"
        | PMOD_KW atom
        | MOD_KW atom

// A LaTeX command ends at the first non-letter, so `\in` never eats the start
// of `\infty` and `\le` never the start of `\left`.
REL_OP.2: "<=" | ">=" | "!=" | "/=" | /\\neq(?![a-zA-Z])/
        | /\\le(?![a-zA-Z])/ | /\\leq(?![a-zA-Z])/ | /\\ge(?![a-zA-Z])/ | /\\geq(?![a-zA-Z])/
        | "<" | ">" | "=" | /\\equiv(?![a-zA-Z])/ | /\\in(?![a-zA-Z])/ | /\bin\b/i
        | /\\notin(?![a-zA-Z])/ | /\bnot\s+in\b/i
        | /\\subset(?![a-zA-Z])/ | /\bsubset\b/i | /\\subseteq(?![a-zA-Z])/ | /\bsubseteq\b/i
        | "≤" | "≥" | "≠" | "≡" | "∈" | "∉" | "⊂" | "⊆"

// arith_expr / term: left-recursive named rules so op is always present
arith_expr: arith_expr ADDOP term
           | term

term: term MULOP unary_factor
    | unary_factor

?unary_factor: ADDOP unary_factor -> unary_op
             | power

// power is right-recursive; keep as non-? so transformer sees [base, POW_OP, exp]
// The exponent may carry a sign, so `a^-1` and `x^(-1)` both parse.
power: postfix POW_OP unary_factor
     | postfix

// Postfix operators bind tighter than ^ : `n!`, `(n - 1)!`, `a⁻¹`, `x²`.
?postfix: atom
        | postfix BANG          -> factorial_op
        | postfix SUPERSCRIPT   -> superscript_op

?atom: NUMBER                              -> number
     | STRING                              -> string_literal
     | SUM_KW "_" "{" CNAME REL_OP arith_expr "}" POW_OP "{" arith_expr "}" unary_factor -> latex_sum
     | SUM_KW "_" "{" CNAME REL_OP arith_expr "}" POW_OP atom unary_factor               -> latex_sum
     | INT_KW "_" "{" arith_expr "}" POW_OP "{" arith_expr "}" arith_expr diff_spec      -> latex_definite_int
     | INT_KW "_" atom POW_OP atom arith_expr diff_spec                                   -> latex_definite_int
     | INT_KW arith_expr diff_spec                                                       -> latex_indefinite_int
     | LIM_KW "_" "{" CNAME TO_OP expr LIM_DIR? "}" term                                 -> latex_limit
     | PIPE arith_expr PIPE                -> abs_expr
     | EMPTYSET_KW                         -> empty_set
     | INFTY_KW                            -> infinity
     | TYPE_SET                            -> type_symbol
     | SQRT_OP atom                        -> sqrt_prefix
     | vector_literal
     | CNAME "(" (expr ("," expr)*)? ")"  -> func_call
     | GREEK_LETTER                       -> greek_symbol
     | CNAME                              -> symbol
     | "(" expr ")"
     | "$" /[^$]+/ "$"                   -> raw_math

diff_spec: DIFF_D? CNAME
vector_literal: "[" (expr ("," expr)*)? "]"

// -----------------------------------------------------------------------
// Operator terminals
// -----------------------------------------------------------------------

PIPE:    "|"
ADDOP.2:   "+" | "-" | "\\cup" | /\bunion\b/i | "\\setminus" | /\bsetminus\b/i | "−" | "∪"
MULOP.2:   "*" | "/" | "\\cap" | /\bintersect\b/i | "\\circ" | "\\cdot" | /\\times(?![a-zA-Z])/
         | "·" | "×" | "∩" | "∘"
POW_OP:  "^" | "**"
BANG.2:  /!(?!=)/
SUPERSCRIPT.2: /[⁺⁻]?[⁰¹²³⁴-⁹]+/
SQRT_OP.2: "√"
INFTY_KW.3: /\\infty(?![a-zA-Z])/ | "∞" | /\b(oo|infinity)\b/
TYPE_SET.2: "ℝ" | "ℤ" | "ℕ" | "ℚ" | "ℂ"
IFF_OP.3:  "<=>" | "<->" | "\\iff" | /\biff\b/i | "⇔" | "⟺" | "↔"
IMPL_OP.3: "=>" | "->" | "\\implies" | /\bimplies\b/i | "⇒" | "⟹"
OR_OP.2:   "\\lor" | "\\/" | /\bor\b/i | "∨"
AND_OP.2:  "\\land" | "/\\" | /\band\b/i | "∧"
NOT_OP.2:  "\\neg" | "~" | /\bnot\b/i | "¬"
EMPTYSET_KW.2: "\\emptyset" | "\\empty" | "\\varnothing" | /EmptySet\b/ | /\bemptyset\b/i | "∅"

// -----------------------------------------------------------------------
// Statement keywords (priority 2 so they beat CNAME)
// -----------------------------------------------------------------------

SUM_KW.2:       "\\sum"
INT_KW.3:       "\\int"
LIM_KW.3:       "\\lim"
// A direction only where it closes the limit subscript (`0^+}`); anywhere
// else `^-` is a power with a signed exponent (`a^-1`).
LIM_DIR.3:      /\^[+-](?=\s*\})/
DIFF_D.2:       "\\mathrm{d}" | "\\,d" | "\\, d" | "\\operatorname{d}" | "\\d"
TO_OP.2:        /\\to(?![a-zA-Z])/ | "\\rightarrow" | "->" | "→"
MOD_PAR_KW.3:   /\(\s*mod\b/i
MOD_KW.3:       /\bmod\b/i
PMOD_KW.3:      "\\pmod"
QUANT_EXISTS.2: /exists/i | "\\exists" | "∃"
QUANT_FORALL.2: /forall/i | "\\forall" | "∀"
THEOREM_KW.2:   /theorem/i | /lemma/i | /proposition/i
CLAIM_KW.2:     /claim/i
PROOF_KW.2:     /proof/i
QED_KW.2:       /qed/i
VAR_INTRO.2:    /let/i | /given/i | /fix/i | /take/i
DEFINE_KW.2:    /define/i | /definition/i
ASSUME_KW.2:    /assume/i | /suppose/i | /hypothesize/i
OBTAIN_KW.2:    /obtain/i | /choose/i | /pick/i
SUCH_THAT.2:    /such that/i | /where/i | /satisfying/i
STEP_KW.2:      /step/i
DEDUCE_KW.2:    /therefore/i | /thus/i | /hence/i | /so/i | /then/i | /conclude/i
CASE_KW.2:      /case/i
BASE_CASE_KW.2: /base case/i
IND_STEP_KW.2:  /inductive step/i | /induction step/i
IMPORT_KW.2:    /import/i

// JUST_TEXT matches words separated by spaces (won't consume brackets/newlines/colons)
JUST_TEXT: /[a-zA-Z0-9_,.^+*\-\\\/"']+(\s+[a-zA-Z0-9_,.^+*\-\\\/"']+)*/

NUMBER:       /[0-9]+(\.[0-9]+)?/
STRING:       /\"[^\"]*\"/
GREEK_LETTER: /\\(alpha|beta|gamma|delta|epsilon|varepsilon|zeta|eta|theta|iota|kappa|lambda|mu|nu|xi|pi|rho|sigma|tau|upsilon|phi|varphi|chi|psi|omega|Delta|Gamma|Theta|Lambda|Xi|Pi|Sigma|Phi|Psi|Omega)(?![a-zA-Z])/
            | /[α-ωϵϕΓΔΘΛΞΠΣΦΨΩ]/
CNAME:        /[a-zA-Z_][a-zA-Z0-9_]*/

_NL:    /(\r?\n[\t ]*)+/
%declare _INDENT _DEDENT
%ignore " "
%ignore /\t/
%ignore /(#[^\n]*)/
%ignore /(--[^\n]*)/
