{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pack.schema.json",
  "title": "Course pack, format 1",
  "description": "A copy of the rules in src/aether/packs.py for authors working outside Python. packs.py is the authority; tests/test_packs.py keeps the two in step.",
  "type": "object",
  "required": ["format", "name", "version", "title", "summary", "license", "chapters", "entries"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$" },
    "title": { "type": "string", "minLength": 1 },
    "courses": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "summary": { "type": "string", "minLength": 1 },
    "authors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "license": { "type": "string", "minLength": 1 },
    "engine": { "type": "string", "minLength": 1 },
    "depends": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": { "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 } }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "chapter", "ref", "title", "kind", "expected", "source"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "chapter": { "type": "string" },
          "ref": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["proof", "trap"] },
          "expected": { "enum": ["VALID", "WARN", "INVALID", "PARSE ERROR"] },
          "source": { "type": "string", "minLength": 1 },
          "explanation": { "type": "string", "minLength": 1 },
          "blurb": { "type": "string", "minLength": 1 }
        },
        "if": { "properties": { "kind": { "const": "trap" } } },
        "then": { "required": ["explanation"], "properties": { "expected": { "const": "INVALID" } } }
      }
    }
  }
}
